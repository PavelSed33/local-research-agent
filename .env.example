# Модель с OpenAI-совместимым API
LLM_API_KEY=замените_на_ключ_модели
LLM_MODEL=замените_на_название_модели
LLM_BASE_URL=https://api.openai.com/v1
# Договоры не отправляются облачной модели без явного согласия.
# Для осознанной передачи договоров удалённому LLM раскомментируйте:
# ALLOW_CLOUD_DOCUMENTS=true

# Поисковый сервис Tavily
TAVILY_API_KEY=замените_на_ключ_tavily
TAVILY_API_URL=https://api.tavily.com/search
# Официальный портал правовой информации (публичный read-only API)
PRAVO_PORTAL_API_BASE_URL=https://publication.pravo.gov.ru
PRAVO_PORTAL_TIMEOUT_SECONDS=8
LEGAL_SEARCH_DOMAINS=pravo.gov.ru,www.consultant.ru,www.garant.ru
# Домены для отдельного этапа поиска судебной практики
COURT_SEARCH_DOMAINS=kad.arbitr.ru,vsrf.ru,sudact.ru

# HTTP API (для запуска через api.py)
API_HOST=127.0.0.1
API_PORT=8080
# API_OUTPUT_DIR=результаты
# Токен обязателен, если API_HOST не loopback (например, 0.0.0.0 в Docker).
# Каждый POST-запрос требует Authorization: Bearer <API_TOKEN>.
# API_TOKEN=


# HTTP /ask: сохранять отчёты и журналы постоянно (по умолчанию false).
# В режиме false временные файлы удаляются после формирования ответа.
API_PERSIST_RESEARCH=false

# Общий дедлайн рабочего запроса API (секунды, больше 0, максимум 3600).
API_REQUEST_TIMEOUT_SECONDS=300
