# Модель с OpenAI-совместимым API
LLM_API_KEY=замените_на_ключ_модели
LLM_MODEL=замените_на_название_модели
LLM_BASE_URL=https://api.openai.com/v1

# Поисковый сервис Tavily
TAVILY_API_KEY=замените_на_ключ_tavily
TAVILY_API_URL=https://api.tavily.com/search
LEGAL_SEARCH_DOMAINS=pravo.gov.ru,publication.pravo.gov.ru
# Домены для отдельного этапа поиска судебной практики
COURT_SEARCH_DOMAINS=kad.arbitr.ru,vsrf.ru,sudact.ru

# HTTP API (для запуска через api.py)
API_HOST=127.0.0.1
API_PORT=8080
# API_OUTPUT_DIR=результаты
# Необязательный токен доступа к API (только латиница и цифры).
# Если задан, каждый запрос к /ask требует заголовок Authorization: Bearer <API_TOKEN>.
# API_TOKEN=
